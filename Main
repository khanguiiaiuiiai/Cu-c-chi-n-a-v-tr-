<script>
// --- CHILL SYNTH MUSIC PLAYER (WEB AUDIO API) ---
let audioCtx = null, musicGain = null, masterGain = null, sfxGain = null;
let currentTrackIdx = 0, isPlayingMusic = false, musicTimer = null;

const tracks = [
  { name: "Lofi Breeze", bpm: 75, chords: [[261.63, 329.63, 392.00, 493.88], [220.00, 261.63, 329.63, 392.00], [174.61, 220.00, 261.63, 329.63], [196.00, 246.94, 293.66, 349.23]] },
  { name: "Neon Night Chill", bpm: 85, chords: [[146.83, 220.00, 261.63, 329.63], [174.61, 220.00, 261.63, 349.23], [220.00, 261.63, 329.63, 440.00], [196.00, 246.94, 293.66, 392.00]] },
  { name: "Cosmic Ambient", bpm: 60, chords: [[130.81, 196.00, 261.63, 329.63], [110.00, 164.81, 220.00, 293.66], [138.59, 207.65, 277.18, 349.23], [146.83, 220.00, 293.66, 369.99]] }
];

function initAudio() {
  if (audioCtx) return;
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  masterGain = audioCtx.createGain();
  musicGain = audioCtx.createGain();
  sfxGain = audioCtx.createGain();
  
  musicGain.connect(masterGain);
  sfxGain.connect(masterGain);
  masterGain.connect(audioCtx.destination);
  
  updateVolumes();
  startChillMusic();
}

function updateVolumes() {
  if (!audioCtx) return;
  const v1 = (document.getElementById('s1')?.value || 80) / 100;
  const v2 = (document.getElementById('s2')?.value || 70) / 100;
  const v3 = (document.getElementById('s3')?.value || 80) / 100;
  if(masterGain) masterGain.gain.value = v1;
  if(musicGain) musicGain.gain.value = v2 * 0.4;
  if(sfxGain) sfxGain.gain.value = v3;
}

function playChord(freqs, duration) {
  if (!audioCtx || audioCtx.state !== 'running') return;
  freqs.forEach(f => {
    let osc = audioCtx.createOscillator();
    let g = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(f, audioCtx.currentTime);
    g.gain.setValueAtTime(0.001, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.1, audioCtx.currentTime + 0.1);
    g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration - 0.05);
    osc.connect(g);
    g.connect(musicGain);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
  });
}

function startChillMusic() {
  if (musicTimer) clearTimeout(musicTimer);
  isPlayingMusic = true;
  let track = tracks[currentTrackIdx];
  document.getElementById('musicTrack').innerText = "Đang phát: " + track.name;
  
  let chordStep = 0;
  let duration = (60 / track.bpm) * 2;

  function loop() {
    if (!isPlayingMusic) return;
    playChord(track.chords[chordStep], duration);
    chordStep = (chordStep + 1) % track.chords.length;
    
    if (chordStep === 0 && Math.random() < 0.3) {
      // Tự chuyển bài ngẫu nhiên khi hết 1 vòng lặp lớn
      currentTrackIdx = (currentTrackIdx + 1) % tracks.length;
      track = tracks[currentTrackIdx];
      document.getElementById('musicTrack').innerText = "Đang phát: " + track.name;
    }
    musicTimer = setTimeout(loop, duration * 1000);
  }
  loop();
}

document.getElementById('nextTrack')?.addEventListener('click', () => {
  currentTrackIdx = (currentTrackIdx + 1) % tracks.length;
  startChillMusic();
});

['click', 'touchstart'].forEach(ev => addEventListener(ev, () => { if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume(); }, { once: true }));

// --- GAME LOGIC & GRAPHICS ENHANCEMENTS ---
const cv=document.getElementById('c'),mg=cv.getContext('2d');let g=mg;
const lo=document.createElement('canvas'),lg=lo.getContext('2d'),PX=3;
let W,H;
function rs(){const d=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;lo.width=Math.ceil(W/PX);lo.height=Math.ceil(H/PX);g.setTransform(d,0,0,d,0,0)}
addEventListener('resize',rs);rs();

// Particles System
let particles = [];
function addParticle(x, y, color, size, vx, vy, life) {
  particles.push({x, y, color, size, vx, vy, life, maxLife: life});
}

function updateAndDrawParticles() {
  for (let i = particles.length - 1; i >= 0; i--) {
    let p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    let alpha = p.life / p.maxLife;
    g.save();
    g.globalAlpha = alpha;
    g.fillStyle = p.color;
    g.beginPath();
    g.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    g.fill();
    g.restore();
    if (p.life <= 0) particles.splice(i, 1);
  }
}

// Nâng cấp nét vẽ đền thờ Sukuna
function drawSukunaShrine(x, y) {
  g.save();
  g.translate(x, y);
  
  // Nền âm khí
  let grad = g.createRadialGradient(0, -60, 20, 0, -60, 180);
  grad.addColorStop(0, 'rgba(180, 0, 30, 0.4)');
  grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
  g.fillStyle = grad;
  g.beginPath(); g.arc(0, -60, 180, 0, Math.PI * 2); g.fill();

  // Mái đền chính
  g.fillStyle = '#1a0505';
  g.strokeStyle = '#e53935';
  g.lineWidth = 3;
  
  // Tầng mái trên
  g.beginPath();
  g.moveTo(-90, -100);
  g.quadraticCurveTo(0, -130, 90, -100);
  g.lineTo(70, -80);
  g.quadraticCurveTo(0, -95, -70, -80);
  g.closePath();
  g.fill(); g.stroke();

  // Tầng mái dưới
  g.beginPath();
  g.moveTo(-120, -60);
  g.quadraticCurveTo(0, -90, 120, -60);
  g.lineTo(90, -40);
  g.quadraticCurveTo(0, -55, -90, -40);
  g.closePath();
  g.fill(); g.stroke();

  // Cột đền & Sọ người hoa văn
  g.fillStyle = '#2d0a0a';
  g.fillRect(-60, -40, 15, 60);
  g.fillRect(45, -40, 15, 60);
  
  // Đốm lửa tế lễ
  let fireScale = 1 + Math.sin(Date.now() * 0.01) * 0.2;
  g.fillStyle = '#ff5500';
  g.beginPath(); g.arc(-52, -45, 8 * fireScale, 0, Math.PI*2); g.fill();
  g.beginPath(); g.arc(52, -45, 8 * fireScale, 0, Math.PI*2); g.fill();

  g.restore();
}

// Nâng cấp nét vẽ Lãnh địa Vô Lượng Không Xứ (Gojo)
function drawGojoDomain(x, y, r) {
  g.save();
  let grad = g.createRadialGradient(x, y, 10, x, y, r);
  grad.addColorStop(0, 'rgba(10, 15, 40, 0.9)');
  grad.addColorStop(0.7, 'rgba(20, 60, 120, 0.7)');
  grad.addColorStop(1, 'rgba(128, 216, 255, 0.3)');
  
  g.fillStyle = grad;
  g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.fill();
  
  // Các ngôi sao lấp lánh bên trong
  let time = Date.now() * 0.002;
  g.fillStyle = '#ffffff';
  for(let i = 0; i < 16; i++) {
    let angle = i * 0.4 + time;
    let dist = (i * 17) % (r - 20);
    let sx = x + Math.cos(angle) * dist;
    let sy = y + Math.sin(angle) * dist;
    g.globalAlpha = Math.abs(Math.sin(time + i));
    g.beginPath(); g.arc(sx, sy, 2, 0, Math.PI * 2); g.fill();
  }
  g.restore();
}

