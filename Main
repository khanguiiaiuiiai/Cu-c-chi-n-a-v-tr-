// UI & Menu Interactivity
document.getElementById('gear').onclick = () => {
  initAudio();
  document.getElementById('set').classList.remove('hide');
};
document.getElementById('sOk').onclick = () => {
  document.getElementById('set').classList.add('hide');
};
document.getElementById('s1').oninput = updateVolumes;
document.getElementById('s2').oninput = updateVolumes;
document.getElementById('s3').oninput = updateVolumes;

function toMenu() {
  document.getElementById('end').classList.add('hide');
  document.getElementById('menu').classList.remove('hide');
  document.getElementById('gear').style.display = 'none';
}

